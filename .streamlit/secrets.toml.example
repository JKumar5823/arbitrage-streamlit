# Copy to .streamlit/secrets.toml and fill in to enable the Google API sources.
# Optional: the app works without it via ICS feeds, public sheet links and uploads.
# This file must never be committed -- .gitignore already excludes secrets.toml.

[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "fundraising-dashboard@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
