# --- PitchBook Capture Room configuration ---
# Copy to .env and fill in. Load with your shell or a tool like direnv,
# or just paste these into the Streamlit sidebar at runtime.

# Claude vision extraction (recommended). Without this the room falls back to
# local Tesseract OCR (raw text only).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cloud SQL database. Set this for cloud storage; leave unset to use a local
# SQLite file (pitchbook.db). Examples:
#   AWS RDS Postgres:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@mydb.abcdef.us-east-1.rds.amazonaws.com:5432/pitchbook
#   Neon (serverless Postgres):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/pitchbook?sslmode=require
#   Supabase:
# DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Optional: where local SQLite db + screenshots are written.
# PITCHBOOK_DB_PATH=pitchbook.db
# PITCHBOOK_SHOT_DIR=captures
